---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

// Roles from the sponsor deck draft — confirm names, titles, and that everyone is okay being listed.
// Bios, photos, pronouns, and links come from Futurefull-Team-Highlights-Bios-and-Photos.pdf; anyone without them keeps the placeholder.
type Member = { name: string; role: string; pronouns?: string; photo?: string; url?: string; bio?: string };
const team: Member[] = [
  {
    name: 'Dain Saint', role: 'Founder & Artistic Director', pronouns: 'they/he',
    photo: '/team/dain-saint.jpg', url: 'https://dainsaint.com',
    bio: 'Dain Saint is an interactive storyteller in Philadelphia. They\u2019ve made indie games, immersive theatre, interactive journalism, and a bunch of weird music. They\u2019re building Futurefull, a community for creators telling stories about the future and the roads we take to get there. They will give you an existential crisis, respectfully.',
  },
  {
    name: 'Cat Ramirez', role: 'Producer', pronouns: 'they/he/she',
    photo: '/team/cat-ramirez.jpg', url: 'https://catramirez.com',
    bio: 'Cat Ramirez is a queer, mixed race, Philly-based performance director and producer who loves logistical puzzles, community meals, and bisexual lighting. Cat is the Creative Producer and a worker-owner for Obvious Agency. They serve as a Board Member of the Stockton Rush Bartol Foundation, and are an alumni of the National New Play Network\u2019s Producer-In-Residence Program.',
  },
  { name: 'Aetherius Bordeaux', role: 'Community & Outreach' },
  {
    name: 'Mel Hsu', role: 'Operations Manager', pronouns: 'she/they',
    photo: '/team/mel-hsu.jpg', url: 'https://www.melhsu.com',
    bio: 'Mel Hsu is a spreadsheet nerd, a slow reader and a shameless instigator of kitchen dance parties. Rooted in Philly, Mel\u2019s restless spirit finds adventure across time zones and oceans as musical and administrative support for others who inspire her. Mel recently bought a laminator and it\u2019s changing their life.',
  },
  { name: 'Troi Williams', role: 'Social Media' },
  { name: 'Markiesha Thompson', role: 'Development' },
  { name: 'Taj Rauch', role: 'Experience Design' },
];
const avatarSurfaces = ['surface-sun', 'surface-coral', 'surface-navy', 'surface-white'];
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
const partners = ['The Laundromat Project', 'Caribbean Community of Philadelphia', 'Young Artists Program', 'Indy Hall'];
---

<Base title="Who we are — Futurefull">
  <header class="surface-sun"><div class="wrap"><Nav /></div></header>

  <section id="who" class="region">
    <div class="wrap stack space-s3">
      <div class="switcher space-s3 valign-start">
        <div class="stack">
          <span class="eyebrow accent">Who we are</span>
          <h2>An interfuturist storytelling collective</h2>
          <p class="title" style="font-size:var(--step-2);text-wrap:balance">Telling stories about better futures and the roads to get there.</p>
          <p class="lede">
            Queer BIPOC nerds and the people who love them. Actual play, immersive theatre, TTRPGs, live events, storytelling circles. Participatory, community-centered, speculative and hopeful. Based in Philadelphia, touring beyond it.
          </p>
        </div>
        <ul class="stack space-s0" role="list">
          <li class="card stat stack surface-navy space-s-1">
            <b class="stat__figure display">100+</b>
            <span class="stat__label">Olamina participants across Philadelphia + Brooklyn</span>
          </li>
          <li class="card stat stack surface-coral space-s-1">
            <b class="stat__figure display">Winner</b>
            <span class="stat__label">Olamina — 2026 Black Immersive Creators Grant</span>
          </li>
        </ul>
      </div>

      <div class="stack">
        <h3 class="eyebrow" data-rule>The people</h3>
        <ul class="grid" role="list" style="--min:16rem;--space:var(--s2)">
          {team.map((p, i) => (
            <li class="stack space-s-1">
              {p.photo ? (
                <div class="slot" data-shape="square"><img src={p.photo} width="640" height="640" alt={p.name} loading="lazy" /></div>
              ) : (
                <div class:list={['slot display', avatarSurfaces[i % avatarSurfaces.length]]} data-shape="square" style="font-size:var(--step-3)">{initials(p.name)}</div>
              )}
              <h4 class="title">{p.name}{p.pronouns && <span class="text-small muted weight-semibold"> ({p.pronouns})</span>}</h4>
              <p class="eyebrow accent">{p.role}</p>
              {p.bio ? <p class="text-small">{p.bio}</p> : <p class="text-small muted">[ one-line bio ]</p>}
              {p.url && <p class="text-small"><a href={p.url}>{p.url.replace(/^https?:\/\/(www\.)?/, '')}</a></p>}
            </li>
          ))}
        </ul>
      </div>

      <div class="stack">
        <h3 class="eyebrow">Partners</h3>
        <ul class="cluster" role="list">
          {partners.map((p) => <li class="tag surface-white">{p}</li>)}
        </ul>
      </div>

      <blockquote class="pullquote prose">
        <p>“This gave me a feeling I haven’t had since I left the church.”</p>
        <cite class="eyebrow">Olamina participant</cite>
      </blockquote>
    </div>
  </section>
</Base>
